# Copy to .env and supply your own hub token. Never commit the real token.
LAB_URL=https://ee-auto.up.railway.app
LAB_TOKEN=replace-with-your-hub-token
WORKER_NAME=country-industry-worker
WORKER_TYPES=country.industry
# Optional: path to Chrome when it is not in a standard installation location.
# CHROME_PATH=/path/to/chrome
# Optional: directory for per-job checkpoints and results.
# COUNTRY_INDUSTRY_JOB_ROOT=/path/to/private/results
# Optional: disable the worker's local dashboard.
# WORKER_DASHBOARD_DISABLE=1
